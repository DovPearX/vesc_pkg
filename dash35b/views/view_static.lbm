(def wheelie-open nil)
(def wheelie-drawn nil)
(def wheelie-static-paused nil)
(def wheelie-selected 0)

@const-start

(defun view-static-state () (list
        indicate-l-on                       ; 0
        indicate-r-on                       ; 1
        highbeam-on                         ; 2
        kickstand-down                      ; 3
        drive-mode                          ; 4
        performance-mode                    ; 5
        cruise-control-active               ; 6
        cruise-control-speed                ; 7
        (round (* 100.0 stats-battery-soc)) ; 8
        battery-a-charging                  ; 9
        stats-fault-code                    ; 10
        (round stats-temp-esc)              ; 11
        (round stats-temp-battery)          ; 12
        (round (secs-since 0))              ; 13
        (cond
            (temp-ambient-rx temp-ambient)
            ((> (get-bms-val 'bms-temp-adc-num) 4) (get-bms-val 'bms-temps-adc 4))
            (t -300.0)
        ) ; 14
        (* (round (* stats-vin 10)) 0.1)    ; 15
        (round (u-speed stats-kmh))         ; 16
        (round stats-amps-now)              ; 17
        cruise-control-active               ; 18
        (round cruise-control-speed)        ; 19
        light-on                            ; 20
        page-now                            ; 21
        (round stats-temp-motor)            ; 22
        battery-a-charging                  ; 23
        battery-a-chg-time                  ; 24
        date-time                           ; 25
))

;(print (ix (view-static-state) 25))

; Not in update-state, so it is redrawn on a forced pass.
(defun view-static-frame () {
        (scene-present img-vesc 16 7 colors-vesc)
        (scene-present img-batt-level 10 83 colors-white-aa)
})

(defun speed-dial-angle (current) {
        (var limit (if (> current 0) config-curr-accel config-curr-brake))
        (+ -90.0 (* current (/ 90.0 limit)))
})

(defun speed-dial (angle) {
        (var dial (scene-buffer 'indexed4 276 114))
        (scene-circle dial 138 140 140 1 '(filled))
        (scene-arc dial 138 140 140 -180 0 2 '(thickness 8))
        (if (!= angle -90.0) {
                (var start (scene-min angle -90.0))
                (var end (scene-max angle -90.0))
                (scene-arc dial 138 140 140 start end 3 '(thickness 8))
        })
        (ttf-txt-center (u-speed-str) font-16-2c dial '(0 3) 30)
        dial
})

(defun speed-number-damage (width)
    (list (+ 102 (/ (- 276 width) 2)) 246 width 66))

(defun speed-dial-damage (previous angle) {
        (var start (* (scene-min previous angle) 0.01745329252))
        (var end (* (scene-max previous angle) 0.01745329252))
        (var peak (clamp -1.5707963 start end))
        (var left (+ 228 (to-i (* 140.0 (cos start)))))
        (var right (+ 253 (to-i (* 140.0 (cos end)))))
        (var top (+ 334 (to-i (* 140.0 (sin peak)))))
        (var lower-edge (scene-max (sin start) (sin end)))
        (var bottom (+ 359 (to-i (* 140.0 lower-edge))))
        (list left top (- right left) (- bottom top))
})

(defun speed-number (text width dirty-width) {
        (var number (scene-buffer 'indexed2 dirty-width 66))
        (scene-text number (/ (- dirty-width width) 2) 65 '(0 1) font-90 text)
        (var left (+ 102 (/ (- 276 dirty-width) 2)))
        (var palette (list (ix colors-speed 1) (ix colors-speed 3)))
        (scene-present number left 246 palette)
})

(defun battery-color (percent) {
        (var position (/ percent 100.0))
        (var red (ix colors-crit-2 1))
        (var yellow (ix colors-warn-2 1))
        (var green (ix colors-ok-2 1))
        (if (< position 0.5)
            (color-mix red yellow (* 2.0 position))
            (color-mix yellow green (* 2.0 (- position 0.5))))
})

(defun battery-segments (count previous color recolor) {
        (var start-index (if (or recolor (< previous 0)) 0 (scene-min count previous)))
        (var end (if (< previous 0) 10 (scene-max count previous)))
        (if (< start-index end) {
                (var segment (scene-buffer 'indexed2 42 18))
                (scene-rectangle segment 0 0 42 18 1 '(rounded 3) '(filled))
                (var empty (list color-bg (color-mix color-bg color-text 0.12)))
                (var filled-palette (list color-bg color))
                (looprange i start-index end
                    (scene-present segment 14 (- 271 (* i 20))
                        (if (< i count) filled-palette empty)))
        })
})

(defun view-static-thread () {
        (var update-state (map (fn (x) t) (view-static-state)))
        (var state-last (view-static-state))
        (var full-dial t)
        (var last-angle -90.0)
        (var last-width 0)
        (var last-battery-count -1)
        (var last-battery-color -1)

        (view-static-frame)

        (loopwhile t {
                (loopwhile (or wheelie-open wheelie-drawn) {
                        (setq wheelie-static-paused t)
                        (sleep 0.025)
                })
                (setq wheelie-static-paused nil)

                ; Indicator L
                (var state-ind 0)
                (if (ix update-state state-ind) {
                        (if (icon-on 0)
                            (if (ix state-last state-ind)
                                (scene-present img-indicator-l 70 12 colors-green-icon)
                                (scene-present img-indicator-l 70 12 colors-dim-icon)
                            )
                            (scene-present img-indicator-l 70 12 colors-hidden)
                        )
                })

                ; Warning
                (var state-ind 10)
                (if (ix update-state state-ind) {
                        (if (icon-on 4)
                            (if (!= (ix state-last state-ind) 0)
                                (scene-present img-warning 124 11 colors-red-icon)
                                (scene-present img-warning 124 11 colors-dim-icon)
                            )
                            (scene-present img-warning 124 11 colors-hidden)
                        )
                })

                ; High Beam
                (if (or (ix update-state 2) (ix update-state 20)) {
                        (if (icon-on 1)
                            (if light-on-is-highbeam
                                (if (ix state-last 20)
                                    (scene-present img-highbeam 175 14 colors-blue-icon)
                                    (scene-present img-lowbeam 175 14 colors-green-icon)
                                )
                                (cond
                                    ((ix state-last 2) (scene-present img-highbeam 175 14 colors-blue-icon))
                                    ((ix state-last 20) (scene-present img-lowbeam 175 14 colors-green-icon))
                                    (true (scene-present img-lowbeam 175 14 colors-dim-icon))
                                )
                            )
                            {
                                (scene-present img-highbeam 175 14 colors-hidden)
                                (scene-present img-lowbeam 175 14 colors-hidden)
                            }
                        )
                })

                ; Kick Stand
                (var state-ind 3)
                (if (ix update-state state-ind) {
                        (if (icon-on 2)
                            (if (ix state-last state-ind)
                                (scene-present img-kickstand 278 14 colors-red-icon)
                                (scene-present img-kickstand 278 14 colors-dim-icon)
                            )
                            (scene-present img-kickstand 278 14 colors-hidden)
                        )
                })

                ; Temperature
                (if (or (ix update-state 11) (ix update-state 12) (ix update-state 22)) {
                        (if (icon-on 3)
                            (cond
                                ((> (ix state-last 11) settings-esc-hot) (scene-present img-temp-e 323 10 colors-red-icon))
                                ((> (ix state-last 12) settings-batt-hot) (scene-present img-temp-b 323 10 colors-red-icon))
                                ((> (ix state-last 22) settings-motor-hot) (scene-present img-temp-m 323 10 colors-red-icon))
                                (true                      (scene-present img-temp-b 323 10 colors-dim-icon))
                            )
                            {
                                (scene-present img-temp-e 323 10 colors-hidden)
                                (scene-present img-temp-b 323 10 colors-hidden)
                                (scene-present img-temp-m 323 10 colors-hidden)
                            }
                        )
                })

                ; Indicator R
                (var state-ind 1)
                (if (ix update-state state-ind) {
                        (if (icon-on 0)
                            (if (ix state-last state-ind)
                                (scene-present img-indicator-r 374 12 colors-green-icon)
                                (scene-present img-indicator-r 374 12 colors-dim-icon)
                            )
                            (scene-present img-indicator-r 374 12 colors-hidden)
                        )
                })

                ; Mode Symbol
                (if (or (ix update-state 4) (ix update-state 5)) {
                        (var txt (cond
                                ((eq (ix state-last 4) 0)   "R")
                                ((eq (ix state-last 4) 1)   "N")
                                ((eq (ix state-last 4) 2)   "1")
                                ((eq (ix state-last 4) 3)   "2")
                                ((eq (ix state-last 4) 4)   "3")
                                (true                       "N")
                        ))

                        (var imgbuf (scene-buffer 'indexed4 34 40))
                        (scene-clear imgbuf)

                        (ttf-txt-center txt font-48 imgbuf)
                        (scene-present imgbuf 223 8 colors-text-aa)
                })

                ; Clock
                (if (or (ix update-state 13) (ix update-state 25)) {
                        (var imgbuf (scene-buffer 'indexed4 46 17))
                        (scene-clear imgbuf)

                        (var (hh mm)
                            (if (ix state-last 25)
                                (list (to-i (ix (ix state-last 25) 4)) (to-i (ix (ix state-last 25) 5)))
                                (list (mod (/ (to-i (ix state-last 13)) 3600) 24) (mod (/ (to-i (ix state-last 13)) 60) 60))
                        ))

                        (var str (str-merge (str-from-n hh "%02d:") (str-from-n mm "%02d")))

                        (ttf-txt-center str font-16 imgbuf)
                        (scene-present imgbuf 425 9 colors-text-aa)
                })

                ; Temp
                (var state-ind 14)
                (if (ix update-state state-ind) {
                        (var temp (to-i (ix state-last state-ind)))

                        (var imgbuf (scene-buffer 'indexed4 46 17))
                        (scene-clear imgbuf)

                        (var str (if (> temp -200)
                                (str-merge (str-from-n (to-i (u-temp (to-float temp))) "%d ")
                                           (u-temp-str))
                                "---"
                        ))

                        (ttf-txt-center str font-16 imgbuf)
                        (scene-present imgbuf 425 26 colors-text-aa)
                })

                ; Battery %
                (var state-ind 8)
                (if (ix update-state state-ind) {
                        (var percent (to-i (ix state-last state-ind)))

                        (var count (/ (+ (clamp percent 0 100) 9) 10))
                        (var color (if settings-batt-ramp
                            (battery-color (* 5 (/ (clamp percent 0 100) 5)))
                            (ix colors-theme-2 1)))
                        (var recolor (!= color last-battery-color))
                        (battery-segments count last-battery-count color recolor)
                        (setq last-battery-count count)
                        (setq last-battery-color color)

                        (var label (scene-buffer 'indexed4 40 15))
                        (ttf-txt-center (str-from-n percent "%d%%") font-16 label)
                        (scene-present label 16 299 colors-text-aa)
                })

                ; Battery volts
                (var state-ind 15)
                (if (ix update-state state-ind) {
                        (var v-in (to-float (ix state-last state-ind)))

                        ; Batt V
                        (var imgbuf (scene-buffer 'indexed4 60 15))
                        (scene-clear imgbuf)
                        (var str (str-from-n v-in "%.1fV"))
                        (ttf-txt-center str font-16 imgbuf)
                        (scene-present imgbuf 6 59 colors-text-aa)
                })

                ; Speed or Charging
                (if (or (ix update-state 16) (ix update-state 17)
                        (ix update-state 23) (ix update-state 24)) {
                        (if (ix state-last 23) {
                                (var min-left (to-i (ix state-last 24)))
                                (var imgbuf (scene-buffer 'indexed4 276 114))
                                (scene-blit imgbuf img-charging 58 0 0)
                                (ttf-txt-center "Time Left" font-16-2c imgbuf '(0 3) 80)
                                (ttf-txt-center
                                    (str-merge
                                        (str-from-n (/ min-left 60) "%dh ")
                                        (str-from-n (mod min-left 60) "%dmin"))
                                    font-16-2c imgbuf '(0 3) 100)
                                (scene-present imgbuf 102 206 colors-charging)
                                (setq full-dial t)
                        } {
                                (var text (str-from-n (to-float (ix state-last 16))))
                                (var width (ix (ttf-text-dims font-90 text) 0))
                                (var dirty-width (scene-max width last-width))
                                (var angle (speed-dial-angle (to-float (ix state-last 17))))
                                (if (or full-dial (> dirty-width 156)
                                        (< angle -180.0) (> angle 0.0)
                                        (< last-angle -180.0) (> last-angle 0.0)) {
                                        (var dial (speed-dial angle))
                                        (ttf-txt-center text font-90 dial '(0 3) 105)
                                        (scene-present dial 102 206 colors-speed)
                                } {
                                        (if (!= angle last-angle) {
                                                (var area (speed-dial-damage last-angle angle))
                                                (var dial (speed-dial angle))
                                                (var (left top w h) (speed-number-damage width))
                                                (if (scene-clip left top w h area)
                                                    (ttf-txt-center text font-90 dial '(0 3) 105))
                                                (scene-present dial 102 206 colors-speed area)
                                        })
                                        (if (ix update-state 16)
                                            (speed-number text width dirty-width))
                                })
                                (setq full-dial nil)
                                (setq last-angle angle)
                                (setq last-width width)
                        })
                })

                ; Cruise Control
                (if (or (ix update-state 18) (ix update-state 19)) {
                        (var active (ix state-last 18))
                        (var kmh (u-speed (to-float (ix state-last 19))))

                        (var (color-txt color-icon) (if active
                                (list colors-text-aa colors-green-icon)
                                (list colors-dim-icon colors-dim-icon)
                        ))

                        (if (icon-on 5)
                            (scene-present img-cruise 407 225 color-icon)
                            (scene-present img-cruise 407 225 colors-hidden)
                        )

                        (var imgbuf (scene-buffer 'indexed4 52 28))
                        (scene-clear imgbuf)
                        (if (icon-on 5)
                            (ttf-txt-center (str-from-n kmh "%.0f") font-32 imgbuf))
                        (scene-present imgbuf 403 262
                            (if (icon-on 5) color-txt colors-hidden))
                })

                ; Page
                (var state-ind 21)
                (if (ix update-state state-ind) {
                        (var page (to-i (ix state-last state-ind)))

                        (var imgbuf (scene-buffer 'indexed4 74 20))
                        (scene-clear imgbuf)

                        (var str 0)
                        (if (>= page page-num)
                            (setq str "Settings")
                            (setq str (str-merge (str-from-n (+ page 1) "Page %d/") (str-from-n page-num)))
                        )

                        (ttf-txt-center str font-16 imgbuf)
                        (scene-present imgbuf 393 297 colors-text-aa)
                })

                (var force view-force-static)
                (setq view-force-static false)
                (if force {
                        (view-static-frame)
                        (setq full-dial t)
                        (setq last-battery-count -1)
                })

                (var state-new (view-static-state))
                (looprange i 0 (length update-state)
                    (setix update-state i (or force (not-eq (ix state-last i) (ix state-new i))))
                )
                (setq state-last state-new)

                (sleep 0.05)
        })
})
